  "title": "u-blox GNSS Overview (on-call)",
  "uid": "ublox-gnss-overview",
  "description": "Glanceable health view. Green = all OK. Any non-green tile = open the 'u-blox GNSS Health detailed' dashboard.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fix state",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "ublox_fix{port=\"$port\", instance=\"$instance\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO FIX",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "DEAD-RECKON",
                  "color": "purple",
                  "index": 1
                },
                "2": {
                  "text": "2D",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "3D",
                  "color": "green",
                  "index": 3
                },
                "4": {
                  "text": "3D+DR",
                  "color": "yellow",
                  "index": 4
                },
                "5": {
                  "text": "TIME",
                  "color": "green",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      }
    },
