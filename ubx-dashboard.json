{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["gnss", "ublox"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "/dev/ttyS5", "value": "/dev/ttyS5" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(ublox_fix, port)",
        "hide": 0,
        "includeAll": false,
        "label": "Port",
        "multi": false,
        "name": "port",
        "options": [],
        "query": { "query": "label_values(ublox_fix, port)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "u-blox GNSS Health",
  "panels": [

    {
      "id": 1,
      "type": "state-timeline",
      "title": "Fix state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ublox_fix{port=\"$port\"}",
          "legendFormat": "fix",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "text": "NO FIX",       "color": "red",    "index": 0 },
                "1": { "text": "DEAD-RECKON",  "color": "purple", "index": 1 },
                "2": { "text": "2D",           "color": "orange", "index": 2 },
                "3": { "text": "3D",           "color": "green",  "index": 3 },
                "4": { "text": "3D+DR",        "color": "yellow", "index": 4 },
                "5": { "text": "TIME",         "color": "blue",   "index": 5 }
            }}
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    },

    {
      "id": 2,
      "type": "timeseries",
      "title": "Satellite count by C/N0 threshold",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "ublox_sat_count{port=\"$port\"}",                              "legendFormat": "total in view",      "refId": "A" },
        { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"20\"}", "legendFormat": "C/N0 > 20",          "refId": "B" },
        { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"30\"}", "legendFormat": "C/N0 > 30 (usable)", "refId": "C" },
        { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"35\"}", "legendFormat": "C/N0 > 35 (strong)", "refId": "D" },
        { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"40\"}", "legendFormat": "C/N0 > 40 (excellent)","refId": "E" },
        { "expr": "ublox_sat_max_cno{port=\"$port\"}",                            "legendFormat": "max C/N0",           "refId": "F" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "green", "value": 8 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max C/N0" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "none" },
              { "id": "custom.lineStyle", "value": { "fill": "dash" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] } }
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "Front-end stress: mag I/Q (>200 saturates)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "ublox_mag_i{port=\"$port\"}", "legendFormat": "mag I", "refId": "A" },
        { "expr": "ublox_mag_q{port=\"$port\"}", "legendFormat": "mag Q", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "min": 0,
          "max": 255,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 160 },
              { "color": "red",    "value": 200 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Noise floor & jamming indicator",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "ublox_noise_per_ms{port=\"$port\"}",  "legendFormat": "noisePerMS",    "refId": "A" },
        { "expr": "ublox_jam_indicator{port=\"$port\"}", "legendFormat": "jamInd",        "refId": "B" },
        { "expr": "ublox_agc_count{port=\"$port\"}",     "legendFormat": "agcCnt (right)", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red",    "value": 100 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "agcCnt (right)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } },
              { "id": "custom.lineStyle", "value": { "fill": "dot" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Now",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "ublox_fix{port=\"$port\"}",       "legendFormat": "fix",     "refId": "A" },
        { "expr": "ublox_antenna_status{port=\"$port\"}", "legendFormat": "ant",  "refId": "B" },
        { "expr": "ublox_sat_max_cno{port=\"$port\"}",  "legendFormat": "max C/N0", "refId": "C" },
        { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"30\"}", "legendFormat": "sats >30", "refId": "D" },
        { "expr": "ublox_jam_indicator{port=\"$port\"}", "legendFormat": "jam", "refId": "E" },
        { "expr": "ublox_pvt_time_accuracy_ns{port=\"$port\"}", "legendFormat": "tAcc ns", "refId": "F" },
        { "expr": "ublox_pps_quantization_error_ps{port=\"$port\"}", "legendFormat": "qErr ps", "refId": "G" },
        { "expr": "ublox_dop_time{port=\"$port\"}", "legendFormat": "tDOP", "refId": "H" },
        { "expr": "ublox_pvt_sats_used{port=\"$port\"}", "legendFormat": "sats used", "refId": "I" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Time accuracy (headline timing metric)",
      "description": "Lower is better. NAV-PVT tAcc is the receiver's own estimate of how far off true GNSS time the PPS edge can be. PPS quantization error is the residual jitter between the integer-clock-tick PPS pulse and the true second boundary. <50 ns = healthy; >100 ns = warning; >1000 ns = PPS unsuitable for serious timing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "ublox_pvt_time_accuracy_ns{port=\"$port\"}",       "legendFormat": "NAV-PVT tAcc (ns)",        "refId": "A" },
        { "expr": "ublox_pps_quantization_error_ps{port=\"$port\"} / 1000", "legendFormat": "PPS qErr (ns)",     "refId": "B" },
        { "expr": "ublox_clock_time_accuracy_ns{port=\"$port\"}",     "legendFormat": "NAV-CLOCK tAcc (ns)",      "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "scaleDistribution": { "type": "log", "log": 10 } },
          "unit": "ns",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red",    "value": 1000 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Local clock drift & frequency accuracy",
      "description": "NAV-CLOCK drift = how fast the receiver's internal TCXO is gaining/losing relative to disciplined GNSS time. Frequency accuracy is the receiver's estimate of its own oscillator stability (lower = better TCXO). Sudden swings in drift indicate temperature shocks or holdover problems.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "ublox_clock_drift_ns_per_s{port=\"$port\"}",              "legendFormat": "drift (ns/s)",         "refId": "A" },
        { "expr": "ublox_clock_frequency_accuracy_ps_per_s{port=\"$port\"}", "legendFormat": "freq acc (ps/s)",      "refId": "B" },
        { "expr": "ublox_clock_bias_ns{port=\"$port\"}",                     "legendFormat": "clock bias (ns)",      "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "freq acc (ps/s)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "clock bias (ns)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "DOP — satellite geometry quality (tDOP is the one for timing)",
      "description": "Dilution of precision. tDOP is the timing-specific geometry factor — even with strong sats, bad sky geometry hurts PPS accuracy. <1 = excellent, 1–2 = good, 2–5 = acceptable, >5 = poor. Recurring tDOP spikes at the same time of day usually mean an antenna sees only part of the sky.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "ublox_dop_time{port=\"$port\"}",       "legendFormat": "tDOP (timing)", "refId": "A" },
        { "expr": "ublox_dop_geometric{port=\"$port\"}",  "legendFormat": "gDOP",          "refId": "B" },
        { "expr": "ublox_dop_position{port=\"$port\"}",   "legendFormat": "pDOP",          "refId": "C" },
        { "expr": "ublox_dop_horizontal{port=\"$port\"}", "legendFormat": "hDOP",          "refId": "D" },
        { "expr": "ublox_dop_vertical{port=\"$port\"}",   "legendFormat": "vDOP",          "refId": "E" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red",    "value": 5 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "tDOP (timing)" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 10 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Position accuracy & satellites used in fix",
      "description": "Horizontal/vertical accuracy in mm = NAV-PVT's own estimate of the position error. For a stationary timing receiver these should be small and stable; growing values mean fix quality is degrading even if the receiver still reports a 3D fix. 'Sats used' is the actual number of satellites contributing to the solution (right axis).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "ublox_pvt_horizontal_accuracy_mm{port=\"$port\"}", "legendFormat": "horizontal acc (mm)", "refId": "A" },
        { "expr": "ublox_pvt_vertical_accuracy_mm{port=\"$port\"}",   "legendFormat": "vertical acc (mm)",   "refId": "B" },
        { "expr": "ublox_pvt_sats_used{port=\"$port\"}",              "legendFormat": "sats used",           "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "unit": "lengthmm"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sats used" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "short" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } },
              { "id": "custom.lineStyle", "value": { "fill": "dot" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max", "mean"] } }
    },

    {
      "id": 6,
      "type": "heatmap",
      "title": "L1 band spectrogram (MON-SPAN waterfall)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "ublox_spectrum_amplitude{port=\"$port\"}",
          "legendFormat": "{{freq_mhz}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "none",
          "axisLabel": "Frequency (MHz)"
        },
        "rowsFrame": { "layout": "auto" },
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 128,
          "reverse": false
        },
        "cellGap": 0,
        "cellValues": { "unit": "none" },
        "filterValues": { "le": 1e-9 },
        "tooltip": { "show": true, "yHistogram": false, "mode": "single" },
        "legend": { "show": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false }
          }
        }
      }
    }

  ]
}
