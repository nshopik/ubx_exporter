          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "last",
                "min",
                "max",
                "mean"
              ]
            }
          }
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "Position (lat / lon / height MSL)",
          "description": "Reported position from NAV-PVT. For a stationary timing receiver all three lines should be flat. A sudden shift in lat/lon without a corresponding hAcc increase is a strong spoofing indicator. Height (right axis) is above mean sea level.",
