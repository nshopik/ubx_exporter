    "to": "now"
  },
  "timezone": "",
  "title": "u-blox GNSS Health detailed",
  "uid": "ublox-gnss-detailed",
  "panels": [
    {
      "type": "row",
      "id": 16,
      "title": "Verdict",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Fix state",
      "description": "NAV-STATUS fix type. For a stationary timing receiver, expect 3 (3D) or 5 (TIME). 2D fixes lack vertical/timing accuracy. NO FIX (red) sustained beyond a few seconds at startup means the receiver cannot see enough satellites. DEAD-RECKON means the chip is coasting on its last position with no live GNSS input.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "ublox_fix{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "fix",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO FIX",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "DEAD-RECKON",
                  "color": "purple",
                  "index": 1
                },
                "2": {
                  "text": "2D",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "3D",
                  "color": "green",
                  "index": 3
                },
                "4": {
                  "text": "3D+DR",
                  "color": "yellow",
                  "index": 4
                },
                "5": {
                  "text": "TIME",
                  "color": "blue",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Spoofing detection state (receiver's own detector)",
      "description": "NAV-STATUS flags2 spoofDetState. This is the receiver's only built-in spoofing flag and it misses many attacks: NO SPOOFING (green) is not proof of a clean sky. Cross-check with per-constellation usage, pseudorange residuals and ground speed below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "ublox_spoof_detection_state{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "spoof state",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNKNOWN / OFF",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "NO SPOOFING",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "SPOOFING",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "MULTIPLE SPOOFING",
                  "color": "dark-red",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    },
    {
      "type": "row",
      "id": 17,
      "title": "Timing",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time accuracy (headline timing metric)",
      "description": "Lower is better. NAV-PVT tAcc is the receiver's own estimate of how far off true GNSS time the PPS edge can be. PPS quantization error is the residual jitter between the integer-clock-tick PPS pulse and the true second boundary. <50 ns = healthy; >100 ns = warning; >1000 ns = PPS unsuitable for serious timing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "ublox_pvt_time_accuracy_ns{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "NAV-PVT tAcc (ns)",
          "refId": "A"
        },
        {
          "expr": "ublox_pps_quantization_error_ps{port=\"$port\", instance=\"$instance\"} / 1000",
          "legendFormat": "PPS qErr (ns)",
          "refId": "B"
        },
        {
          "expr": "ublox_clock_time_accuracy_ns{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "NAV-CLOCK tAcc (ns)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "ns",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Position accuracy & satellites used in fix",
      "description": "Horizontal/vertical accuracy in mm = NAV-PVT's own estimate of the position error. For a stationary timing receiver these should be small and stable; growing values mean fix quality is degrading even if the receiver still reports a 3D fix. 'Sats used' is the actual number of satellites contributing to the solution (right axis).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "ublox_pvt_horizontal_accuracy_mm{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "horizontal acc (mm)",
          "refId": "A"
        },
        {
          "expr": "ublox_pvt_vertical_accuracy_mm{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "vertical acc (mm)",
          "refId": "B"
        },
        {
          "expr": "ublox_pvt_sats_used{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "sats used",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "lengthmm"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sats used"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "type": "row",
      "id": 18,
      "title": "Spoofing and jamming evidence",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Satellites tracked / used per constellation",
      "description": "NAV-SAT per constellation. Tracked = C/N0 > 0; used = in the navigation solution. A healthy multi-constellation antenna uses satellites from every constellation it tracks. One constellation fully used while another is tracked with good C/N0 but not used means the receiver rejected the other as inconsistent: a spoofing signature.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "ublox_sat_tracked{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "{{gnss}} tracked",
          "refId": "A"
        },
        {
          "expr": "ublox_sat_used{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "{{gnss}} used",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Pseudorange residual of used satellites per constellation",
      "description": "NAV-SAT absolute pseudorange residual of used satellites: how far each measured range sits from the solved position/time. Healthy: under 10 m. Median of tens to hundreds of meters across a constellation means its ranges disagree with the sky: spoofing or severe multipath. A high max with a low median points at one bad satellite. Gaps mean no satellite of that constellation is used.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "ublox_sat_pr_residual_median_m{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "{{gnss}} median",
          "refId": "A"
        },
        {
          "expr": "ublox_sat_pr_residual_max_m{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "{{gnss}} max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "lengthm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Satellites (NAV-SAT, one row per satellite)",
      "description": "NAV-SAT per satellite: C/N0, signed pseudorange residual (used and unused satellites), used flag, qualityInd (0=no signal 1=searching 2=acquired 3=unusable 4=code locked 5-7=code and carrier locked), elevation and azimuth. Spoofed satellites tend to share a flat C/N0 with large residuals; real satellites cut from the solution usually sit low in elevation or C/N0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "max without (__name__) (ublox_sv_cno_dbhz{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max without (__name__) (ublox_sv_pr_residual_m{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max without (__name__) (ublox_sv_used{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max without (__name__) (ublox_sv_quality{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "max without (__name__) (ublox_sv_elevation_deg{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "max without (__name__) (ublox_sv_azimuth_deg{port=\"$port\", instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "port": true
            },
            "indexByName": {
              "gnss": 0,
              "svid": 1
            },
            "renameByName": {
              "Value #A": "C/N0 (dB-Hz)",
              "Value #B": "PR residual (m)",
              "Value #C": "Used",
              "Value #D": "Quality",
              "Value #E": "Elevation (deg)",
              "Value #F": "Azimuth (deg)"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "gnss",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Ground speed (should be ~0 on a fixed antenna)",
      "description": "NAV-PVT 2D ground speed. A fixed timing antenna reads near 0 with tens of mm/s of noise. A sustained speed of meters per second, together with a moving position, means the receiver is following a synthetic trajectory: spoofing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "ublox_pvt_ground_speed_mm_per_s{port=\"$port\", instance=\"$instance\"} / 1000",
          "legendFormat": "ground speed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "velocityms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Noise floor & jamming indicator",
      "description": "Three MON-RF metrics on one panel. noisePerMS: receiver noise floor — normal <70, warning 70–100, critical >100. jamInd: continuous-wave (narrow-band) interference indicator (0–255); no fixed threshold, judge against a baseline from an unjammed period. agcCnt (right axis, dotted): automatic gain control counter — normal 2000–6000, railed at 0 or 8191 means AGC cannot compensate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "ublox_noise_per_ms{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "noisePerMS",
          "refId": "A"
        },
        {
          "expr": "ublox_jam_indicator{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "jamInd",
          "refId": "B"
        },
        {
          "expr": "ublox_agc_count{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "agcCnt (right)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "agcCnt (right)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "min",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 21,
      "type": "state-timeline",
      "title": "Broadband jamming state (receiver's own detector)",
      "description": "MON-RF flags jammingState: the receiver's broadband interference detector. jamInd above covers continuous-wave (narrow-band) interference only. UNKNOWN / OFF means the detector is disabled or has no verdict yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "ublox_jamming_state{port=\"$port\", instance=\"$instance\"}",
          "legendFormat": "jamming state",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNKNOWN / OFF",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "WARNING",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "CRITICAL",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    },
    {
      "type": "row",
      "id": 19,
      "title": "Sky and geometry",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "panels": [
        {
          "id": 2,
          "type": "timeseries",
          "title": "Satellite count by C/N0 threshold",
          "description": "C/N0 = carrier-to-noise density in dB-Hz — how loud each satellite is above the noise floor. Lines show how many satellites exceed each threshold: >20 = detected, >30 = usable for a fix, >35 = strong, >40 = excellent. Need at least 4 sats above 30 for a 3D fix. 'max C/N0' (right axis, dashed) is the single best satellite — open sky with a healthy antenna should reach 40–48 dB-Hz; below 30 means the whole sky is marginal.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 48
          },
          "targets": [
            {
              "expr": "ublox_sat_count{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "total in view",
              "refId": "A"
            },
            {
              "expr": "ublox_sat_cno_above_threshold{port=\"$port\", instance=\"$instance\",threshold=\"20\"}",
              "legendFormat": "C/N0 > 20",
              "refId": "B"
            },
            {
              "expr": "ublox_sat_cno_above_threshold{port=\"$port\", instance=\"$instance\",threshold=\"30\"}",
              "legendFormat": "C/N0 > 30 (usable)",
              "refId": "C"
            },
            {
              "expr": "ublox_sat_cno_above_threshold{port=\"$port\", instance=\"$instance\",threshold=\"35\"}",
              "legendFormat": "C/N0 > 35 (strong)",
              "refId": "D"
