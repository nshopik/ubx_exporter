    {
      "type": "row",
      "id": 20,
      "title": "Receiver internals",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": [
        {
          "id": 3,
          "type": "timeseries",
          "title": "Front-end stress: mag I/Q (>200 saturates)",
          "description": "ADC magnitude of the in-phase (I) and quadrature (Q) signal paths from MON-RF. Range 0–255. Normal is 100–160. Orange threshold at 160 = elevated stress. Red at 200 = front-end is clipping (saturating), which kills satellite reception even though the chip doesn't flag it as jamming. I and Q should track each other; a large split suggests an RF chain imbalance.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 49
          },
          "targets": [
            {
              "expr": "ublox_mag_i{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "mag I",
              "refId": "A"
            },
            {
              "expr": "ublox_mag_q{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "mag Q",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "thresholdsStyle": {
                  "mode": "line"
                }
              },
              "min": 0,
              "max": 255,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 160
                  },
                  {
                    "color": "red",
                    "value": 200
                  }
                ]
              }
            }
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "last",
                "min",
                "max",
                "mean"
              ]
            }
          }
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Local clock drift & frequency accuracy",
          "description": "NAV-CLOCK drift = how fast the receiver's internal TCXO is gaining/losing relative to disciplined GNSS time. Frequency accuracy is the receiver's estimate of its own oscillator stability (lower = better TCXO). Sudden swings in drift indicate temperature shocks or holdover problems.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 49
          },
          "targets": [
            {
              "expr": "ublox_clock_drift_ns_per_s{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "drift (ns/s)",
              "refId": "A"
            },
            {
              "expr": "ublox_clock_frequency_accuracy_ps_per_s{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "freq acc (ps/s)",
              "refId": "B"
            },
            {
              "expr": "ublox_clock_bias_ns{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "clock bias (ns)",
              "refId": "C"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 5,
                "showPoints": "never"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "freq acc (ps/s)"
                },
                "properties": [
                  {
                    "id": "custom.axisPlacement",
                    "value": "right"
                  },
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "purple"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "clock bias (ns)"
                },
                "properties": [
                  {
                    "id": "custom.axisPlacement",
                    "value": "right"
                  },
                  {
                    "id": "custom.lineStyle",
                    "value": {
                      "fill": "dash"
                    }
                  },
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "blue"
                    }
                  }
