                  },
                  {
                    "id": "decimals",
                    "value": 0
                  },
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "green"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "last",
                "min",
                "max",
                "mean"
              ]
            }
          }
        },
        {
          "id": 6,
          "type": "heatmap",
          "title": "L1 band spectrogram (MON-SPAN waterfall)",
          "description": "MON-SPAN waterfall. Each row is a time sample; Y axis is frequency in MHz across the L1 band (~1525–1653 MHz, 128 MHz window centered on 1589 MHz). Color intensity = signal amplitude. A healthy antenna shows a smooth dome shape around 1575 MHz (GPS L1). A bright horizontal stripe at a fixed frequency = narrowband interferer. Note: MON-SPAN only sees this 128 MHz window — out-of-band interferers are invisible here but can still saturate the front-end (check magI/Q).",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
