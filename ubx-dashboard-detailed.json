              "refId": "A"
            },
            {
              "expr": "ublox_pvt_longitude{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "longitude (deg)",
              "refId": "B"
            },
            {
              "expr": "ublox_pvt_height_msl_mm{port=\"$port\", instance=\"$instance\"}",
              "legendFormat": "height MSL (mm)",
              "refId": "C"
            }
