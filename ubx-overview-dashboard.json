{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["gnss", "ublox", "overview", "oncall"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "/dev/ttyS5", "value": "/dev/ttyS5" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(ublox_fix, port)",
        "hide": 0,
        "includeAll": false,
        "label": "Port",
        "multi": false,
        "name": "port",
        "options": [],
        "query": { "query": "label_values(ublox_fix, port)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "u-blox GNSS Overview (on-call)",
  "description": "Glanceable health view. Green = all OK. Any non-green tile = open the detailed 'u-blox GNSS Health' dashboard.",
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Fix state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "expr": "ublox_fix{port=\"$port\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "text": "NO FIX",      "color": "red",    "index": 0 },
                "1": { "text": "DEAD-RECKON", "color": "purple", "index": 1 },
                "2": { "text": "2D",          "color": "orange", "index": 2 },
                "3": { "text": "3D",          "color": "green",  "index": 3 },
                "4": { "text": "3D+DR",       "color": "yellow", "index": 4 },
                "5": { "text": "TIME",        "color": "green",  "index": 5 }
            }}
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        }
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "PPS time accuracy (ns)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "ublox_pvt_time_accuracy_ns{port=\"$port\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red",    "value": 1000 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Sats with C/N0 > 30",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "ublox_sat_cno_above_threshold{port=\"$port\",threshold=\"30\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 4 },
              { "color": "green",  "value": 8 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Antenna",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "ublox_antenna_status{port=\"$port\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "text": "INIT",    "color": "orange", "index": 0 },
                "1": { "text": "UNKNOWN", "color": "orange", "index": 1 },
                "2": { "text": "OK",      "color": "green",  "index": 2 },
                "3": { "text": "SHORT",   "color": "red",    "index": 3 },
                "4": { "text": "OPEN",    "color": "red",    "index": 4 }
            }}
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        }
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Mag I/Q (max)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 5 },
      "targets": [
        { "expr": "max without (__name__) ({__name__=~\"ublox_mag_(i|q)\", port=\"$port\"})", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 255,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 160 },
              { "color": "red",    "value": 200 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Noise / ms",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 5 },
      "targets": [ { "expr": "ublox_noise_per_ms{port=\"$port\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red",    "value": 100 }
            ]
          }
        }
      }
    },

    {
      "id": 7,
      "type": "stat",
      "title": "Jam indicator",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 5 },
      "targets": [ { "expr": "ublox_jam_indicator{port=\"$port\"}", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 255,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 45 },
              { "color": "red",    "value": 95 }
            ]
          }
        }
      }
    },

    {
      "id": 8,
      "type": "stat",
      "title": "Sample age (oldest family)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 5 },
      "targets": [ { "expr": "max(ublox_sample_age_seconds{port=\"$port\"})", "refId": "A" } ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red",    "value": 120 }
            ]
          }
        }
      }
    },

    {
      "id": 9,
      "type": "state-timeline",
      "title": "Fix state — last 6 h",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 10 },
      "timeFrom": "6h",
      "targets": [ { "expr": "ublox_fix{port=\"$port\"}", "legendFormat": "fix", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
                "0": { "text": "NO FIX",       "color": "red",    "index": 0 },
                "1": { "text": "DEAD-RECKON",  "color": "purple", "index": 1 },
                "2": { "text": "2D",           "color": "orange", "index": 2 },
                "3": { "text": "3D",           "color": "green",  "index": 3 },
                "4": { "text": "3D+DR",        "color": "yellow", "index": 4 },
                "5": { "text": "TIME",         "color": "blue",   "index": 5 }
            }}
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.9
      }
    },

    {
      "id": 10,
      "type": "heatmap",
      "title": "L1 spectrogram — last 30 min",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "timeFrom": "30m",
      "targets": [
        {
          "expr": "ublox_spectrum_amplitude{port=\"$port\"}",
          "legendFormat": "{{freq_mhz}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "none",
          "axisLabel": "Frequency (MHz)"
        },
        "rowsFrame": { "layout": "auto" },
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 128,
          "reverse": false
        },
        "cellGap": 0,
        "cellValues": { "unit": "none" },
        "filterValues": { "le": 1e-9 },
        "tooltip": { "show": true, "yHistogram": false, "mode": "single" },
        "legend": { "show": false },
        "exemplars": { "color": "rgba(255,0,255,0.7)" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false }
          }
        }
      }
    }

  ]
}
